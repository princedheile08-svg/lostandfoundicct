# MySQL connection string (TiDB Cloud, PlanetScale, Aiven, Railway... any MySQL with TLS)
DATABASE_URL=mysql://user:password@host:4000/dbname
# Long random string used to sign login cookies
AUTH_SECRET=change-me-to-a-long-random-string
STAFF_PASSWORD=change-me
ADMIN_PASSWORD=change-me-too
# Optional: enables the AI assistant
ANTHROPIC_API_KEY=
# Only if the frontend is on GitHub Pages: its origin, no path (e.g. https://yourname.github.io)
ALLOWED_ORIGIN=
